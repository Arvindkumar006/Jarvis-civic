// Cedar Schema for JARVIS Civic (Application-Level Authorization)
// Defines principals, resources, actions, and attribute constraints.

namespace JarvisCivic {
    entity Citizen;

    entity AuthorityOfficer {
        department: String
    };

    entity MunicipalSupervisor {
        department: String
    };

    entity Administrator;

    entity PublicUser;

    entity CivicCase {
        owner: Citizen,
        department: String,
        status: String,
        is_public: Bool
    };

    entity AuditRecord {
        department: String
    };

    entity CivicDocketSearch {
        department: String
    };

    action create_case appliesTo {
        principal: [Citizen, Administrator],
        resource: [CivicCase]
    };

    action read_own_case appliesTo {
        principal: [Citizen, Administrator],
        resource: [CivicCase]
    };

    action update_own_case appliesTo {
        principal: [Citizen, Administrator],
        resource: [CivicCase]
    };

    action read_public_tracking appliesTo {
        principal: [PublicUser, Citizen, AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicCase]
    };

    action read_authority_case appliesTo {
        principal: [AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicCase]
    };

    action update_case_status appliesTo {
        principal: [AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicCase]
    };

    action add_resolution_note appliesTo {
        principal: [AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicCase]
    };

    action add_evidence appliesTo {
        principal: [Citizen, AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicCase]
    };

    action add_resolution_evidence appliesTo {
        principal: [AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicCase]
    };

    action read_evidence appliesTo {
        principal: [Citizen, AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicCase]
    };

    action read_audit_log appliesTo {
        principal: [MunicipalSupervisor, Administrator],
        resource: [AuditRecord]
    };

    action search_dockets appliesTo {
        principal: [AuthorityOfficer, MunicipalSupervisor, Administrator],
        resource: [CivicDocketSearch]
    };

    action accept_resolution appliesTo {
        principal: [Citizen],
        resource: [CivicCase]
    };

    action reject_resolution appliesTo {
        principal: [Citizen],
        resource: [CivicCase]
    };
}
